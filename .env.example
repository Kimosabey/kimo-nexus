# Contact form (server-send via Nodemailer + Gmail SMTP) — free & open-source.
# Without these, the contact form gracefully falls back to opening the visitor's
# mail client (mailto:), so the site never breaks if they're unset.
#
# Setup (one time):
#   1. Enable 2-Step Verification on the Gmail account below.
#   2. Create an App Password:  https://myaccount.google.com/apppasswords
#      (pick "Mail" → any device name). Google shows a 16-char password.
#   3. Put the values here for local dev (.env.local), and add the SAME two vars
#      in Vercel → Project → Settings → Environment Variables, then redeploy.

GMAIL_USER=harshan.aiyappa@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-no-spaces


# ── Ask assistant (⌘K → Ask) ────────────────────────────────────────────────
# Unset is a supported state: the assistant answers from the site's own data
# (keyword-ranked, deterministic) instead of a model. Nothing breaks, no key needed.
#
# Speech needs no keys at all — dictation and read-aloud use the browser's own
# Web Speech APIs, so there is nothing to configure and nothing to pay for.
#
# Setup (one time):
#   1. Key: https://openrouter.ai/keys
#   2. Add it here (.env.local) and in Vercel → Settings → Environment Variables.
#
# Cost is structurally zero: only ":free" models are ever called, so a traffic
# spike or an abuser can exhaust the day's request quota but can never bill you.
# Free-tier ceiling is 50 requests/day (20/min); holding $10 of credit raises it
# to 1,000/day without spending it. The route reserves headroom below the cap and
# falls back to local mode once the day's budget is gone.

OPENROUTER_API_KEY=
#
# Leave OPENROUTER_MODEL unset unless you have a reason to pin one. The code ships
# a 3-model fallback chain of live free slugs, and setting this replaces the head of
# that chain. Free slugs get promoted to paid without notice and then 404 — a stale
# value here is a slow puncture, so prefer the code default, which is maintained.
# If you do set it, it MUST end in ":free" (see https://openrouter.ai/models?max_price=0).
# OPENROUTER_MODEL=
#
# Optional. Raise to 1000 ONLY while you keep >=$10 credit loaded on the account;
# free models never spend it, so the deposit just unlocks the higher request ceiling.
OPENROUTER_DAILY_CAP=50
